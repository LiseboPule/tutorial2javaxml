<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.dsbkml.PayrollProcessingController" spacing="20" alignment="CENTER" style="-fx-padding: 20;">
    <Label text="Payroll Processing" style="-fx-font-size: 24px;"/>

    <TextField fx:id="monthField" promptText="Month"/>
    <TextField fx:id="yearField" promptText="Year"/>

    <Button fx:id="processPayrollButton" text="Process Payroll" onAction="#processPayroll"
            style="-fx-font-size: 16px;"/>

    <Label text="Payroll Status:" style="-fx-font-size: 20px;"/>
    <ListView fx:id="payrollStatusList" prefHeight="200" prefWidth="300"/>

    <Button fx:id="backButton" text="Back" onAction="#handleBack" style="-fx-font-size: 16px;"/>
</VBox>